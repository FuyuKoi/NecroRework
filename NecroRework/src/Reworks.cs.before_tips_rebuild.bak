        },
        // 灰烬之灵：保留原版键名 BlockOnExhaust（原版 OnUpgrade 会读它，缺了升级会抛
        // KeyNotFoundException），数值与能力里真正用的常量共用一份，卡面再引用这个键。
        // 灰烬之灵：卡面写「飘荡」「格挡」「虚无」。
        [typeof(SpiritOfAsh)] = (CardModel _) => new IHoverTip[3]
