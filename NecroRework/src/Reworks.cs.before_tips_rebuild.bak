        [typeof(SpiritOfAsh)] = async (CardModel card, PlayerChoiceContext ctx, CardPlay play) =>
        {
            await CreatureCmd.TriggerAnim(card.Owner.Creature, "PowerUp", card.Owner.Character.PowerUpAnimDelay);
